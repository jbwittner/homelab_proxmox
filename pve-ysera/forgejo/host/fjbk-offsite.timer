# /etc/systemd/system/fjbk-offsite.timer
#
# UNITÉ DE L'HÔTE PROXMOX (pve-ysera), pas du CT 400.
#
[Unit]
Description=Copie hors-site quotidienne des sauvegardes Forgejo

[Timer]
# 03:50 : une heure après la sauvegarde locale du CT (fj-backup.timer, 02:45),
# assez pour qu'elle soit terminée et son répertoire renommé — on ne copie
# jamais un <stamp>.part. Décalé de vingt minutes par rapport au hors-site du
# CT 200 (03:30), qui vise le même bucket depuis l'autre nœud.
OnCalendar=*-*-* 03:50:00
RandomizedDelaySec=15m
# Le nœud est parfois éteint la nuit : rattraper au démarrage, sinon la copie
# hors-site saute silencieusement les jours d'arrêt.
Persistent=true

[Install]
WantedBy=timers.target
