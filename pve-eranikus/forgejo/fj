#!/usr/bin/python3
#
# fj — point d'entrée de l'outillage Forgejo.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ Installé en /usr/local/sbin/fj sur le nœud (root uniquement)             │
# │ et en /usr/local/bin/fj dans le CT 400.                                  │
# └──────────────────────────────────────────────────────────────────────────┘
#
# Chemin absolu de l'interpréteur, et non /usr/bin/env : le PATH fourni par
# systemd et par « pct exec » est minimal, et /usr/local/bin n'y est pas.
#
# Ce fichier ne contient AUCUNE logique. Il ne fait que deux choses, dans cet
# ordre, avant d'importer quoi que ce soit de conséquent :
#
#   1. placer la bibliothèque sur le chemin d'import ;
#   2. refuser de continuer sous une version de Python trop ancienne.
#
# L'ordre compte : le message de refus doit pouvoir s'afficher même là où le
# reste du code ne s'analyserait pas.

import sys
from pathlib import Path

# Deux dispositions, une seule règle : la bibliothèque est là où l'on a été
# installé, sinon là où le dépôt la range. Pouvoir jouer « ./fj » depuis le
# dépôt sert à comparer une commande à celle qu'elle remplace, sans rien poser
# sur la machine.
_ICI = Path(__file__).resolve().parent
if (_ICI / "fjtool" / "cli.py").is_file():
    # Dépôt : <racine>/lib pour core et proxmox, <service> pour fjtool.
    _CHEMINS = [str(_ICI), str(_ICI.parents[1] / "lib")]
else:
    # Installé : tout a été copié au même endroit.
    _CHEMINS = ["/usr/local/lib/fjtool"]

for _chemin in reversed(_CHEMINS):
    if _chemin not in sys.path:
        sys.path.insert(0, _chemin)

from core import require_python  # noqa: E402 - après la mise en place du chemin

require_python()

from fjtool.cli import main  # noqa: E402 - idem

if __name__ == "__main__":
    sys.exit(main())
