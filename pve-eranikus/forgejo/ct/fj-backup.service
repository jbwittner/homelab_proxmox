# /etc/systemd/system/fj-backup.service
#
# UNITÉ DU CT 400, pas du nœud. Ne pas confondre avec fjbk-offsite.service,
# qui vit sur pve-eranikus et copie ces sauvegardes vers GCS.
#
[Unit]
Description=Sauvegarde logique Forgejo (dump PostgreSQL + app.ini + manifeste)
Documentation=file:///root/homelab_proxmox/pve-eranikus/forgejo/doc/RUNBOOK.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# root, et non postgres : la sauvegarde relit aussi /etc/forgejo/app.ini et
# inventorie /var/lib/forgejo, que postgres ne peut pas lire. Le dump lui-même
# passe par « sudo -u postgres », jamais par une connexion à mot de passe.
User=root
Group=root

Environment=FJ_BACKUP_DEST=/var/backups/forgejo
Environment=FJ_BACKUP_RETENTION=14
Environment=FJ_BACKUP_MIN_FREE_MB=512

# Chemin absolu : le PATH fourni par systemd n'inclut pas /usr/local/bin.
ExecStart=/usr/local/bin/fj backup

# LES DÉPÔTS NE SONT PAS DANS CE DUMP, et c'est un choix. /var/lib/forgejo
# pèse des dizaines de gigaoctets (dépôts, LFS, pièces jointes) : le tarer
# chaque nuit à côté d'une base de quelques centaines de mégaoctets coûterait
# tout l'espace du volume pour une redondance que vzdump assure déjà. La règle
# de partage est écrite une fois, ici :
#
#     la BASE part par cette unité (quotidien, granulaire, restaurable seul) ;
#     les DÉPÔTS partent par vzdump du CT (voir doc/RUNBOOK.md section 9).
#
# Restaurer Forgejo demande LES DEUX, pris à des instants proches. Le manifeste
# écrit par « fj backup » consigne l'empreinte de l'arborescence des dépôts au
# moment du dump : c'est ce qui permet, au moment d'une reprise, de dire si le
# vzdump retenu est cohérent avec le dump retenu.

NoNewPrivileges=true
PrivateTmp=true
