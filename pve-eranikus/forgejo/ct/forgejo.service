[Unit]
Description=Forgejo — source de vérité des dépôts (version épinglée LTS)
Documentation=file:///root/homelab_proxmox/pve-eranikus/forgejo/doc/RUNBOOK.md
After=network-online.target
Wants=network-online.target

# PAS de « After=postgresql.service » : la base n'est pas dans ce conteneur.
# Elle vit dans le CT 200, joignable par le réseau — d'où le seul
# network-online ci-dessus. Un ordre de démarrage local ne dirait rien de la
# disponibilité d'un service qui tourne ailleurs, et le poser donnerait
# l'illusion d'une garantie.
#
# Au démarrage du NŒUD, c'est « startup order » de Proxmox qui compte : le
# CT 200 doit remonter avant le CT 400. Voir doc/RUNBOOK.md section 3.

[Service]
Type=simple
User=git
Group=git
WorkingDirectory=/var/lib/forgejo

# FORGEJO_WORK_DIR, et non GITEA_WORK_DIR : le nom hérité continue de
# fonctionner par compatibilité, ce qui rend son emploi indétectable jusqu'au
# jour où il est retiré. On nomme le logiciel qu'on installe.
Environment=FORGEJO_WORK_DIR=/var/lib/forgejo
# Le PATH de systemd est minimal et n'inclut pas /usr/local/bin : Forgejo
# lance « git » et « git-lfs » en sous-processus, il lui faut donc un PATH
# qui les contienne, énoncé ici plutôt que deviné.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GIT_LFS_SKIP_SMUDGE=1

# Chemin absolu, jamais le symlink /usr/local/bin/forgejo : une unité doit
# pouvoir démarrer même si /usr/local/bin a été nettoyé, et le binaire
# réellement lancé doit être celui que « fj deploy » a vérifié.
ExecStart=/opt/forgejo/forgejo --config /etc/forgejo/app.ini

Restart=always
RestartSec=5s

# Durcissement. Le conteneur est déjà une frontière ; ces réglages-ci
# protègent surtout de Forgejo lui-même — il exécute des hooks git écrits par
# les utilisateurs des dépôts.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# ProtectSystem=full met /usr et /etc en lecture seule : les deux répertoires
# où Forgejo écrit doivent être rouverts explicitement.
ReadWritePaths=/var/lib/forgejo

# Les dépôts, les objets LFS et les pièces jointes tiennent beaucoup de
# fichiers ouverts à la fois. La valeur par défaut du conteneur suffit tant
# qu'aucun miroir ne tourne ; elle ne suffit plus après.
LimitNOFILE=524288:524288

[Install]
WantedBy=multi-user.target
