# /etc/systemd/system/pgbk-offsite.timer
#
# UNITÉ DE L'HÔTE PROXMOX (pve-eranikus), pas du CT 200.
#
[Unit]
Description=Copie hors-site quotidienne des sauvegardes PostgreSQL

[Timer]
# 3h30 : une heure après la sauvegarde locale du CT (pg-backup.timer, 2h30),
# assez pour qu'elle soit terminée et son répertoire renommé — on ne copie
# jamais un <stamp>.part.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15m
# Le nœud est parfois éteint la nuit : rattraper au démarrage, sinon la copie
# hors-site saute silencieusement les jours d'arrêt.
Persistent=true

[Install]
WantedBy=timers.target
